# Copy to .env.local and adjust.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Razorpay test-mode public key (safe to expose to the browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Optional: Android App Links already default to both direct-APK and Play app-signing certificates.
# If set, this REPLACES the defaults; keep both fingerprints to support both install types.
# ANDROID_APP_LINK_SHA256_FINGERPRINTS=0B:A8:AD:F9:80:4E:65:DE:5A:EA:BA:A6:1F:93:84:F6:85:55:08:A4:03:6D:33:C9:C6:BF:E0:74:9E:E2:DF:4B,E5:62:69:9B:F0:52:0B:A0:D9:16:51:5E:70:2A:75:B2:A7:E3:82:AB:C9:B6:31:14:42:D5:6B:73:B8:FA:81:0E
